# Open StackChan Move Hub の設定。.env にコピーして値を変える。
# 未設定の項目は下記の既定値になる。on/off の項目は off / false / 0 で無効。

# --- サーバ ---
# 待ち受けアドレス
HUB_HOST=0.0.0.0
# 待ち受けポート (stackchan_move の 8331 と共存できるよう 8341)
HUB_PORT=8341
# WebSocket への送信 1 回の上限 [s]。超えたらその接続を閉じる
WS_SEND_TIMEOUT_S=10

# --- 駆動 ---
# 起動時の駆動ソース (hub = Web/CLI から操作, joystick = 付属リモコン)
HUB_DRIVE_SOURCE_DEFAULT=hub
# drive 指令を端末へ送る周期 [Hz]
HUB_DRIVE_RATE_HZ=10
# 目標速度がこの秒数更新されなければ停止する [s]
HUB_DRIVE_HOLD_S=1.0
# 前後速度の上限 [m/s]
HUB_MAX_V=0.15
# 旋回角速度の上限 [rad/s]
HUB_MAX_W=2.0
# 車輪の直径 [mm] (シミュレータも参照する)
HUB_WHEEL_DIAMETER_MM=37.0
# 左右車輪の間隔 [mm] (シミュレータも参照する)
HUB_TRACK_WIDTH_MM=77.5
# 端末に要求する odom 送信レート [Hz] (5..50)
HUB_ODOM_HZ=10

# --- カメラ ---
# 端末に要求する初期 fps (1..10)
HUB_CAMERA_FPS=4
# 到着状況に応じて fps を自動調整する (on/off)
HUB_CAMERA_FPS_AUTO=on
# 自動調整の下限 fps
HUB_CAMERA_FPS_MIN=2
# 自動調整の上限 fps
HUB_CAMERA_FPS_MAX=10

# --- 音声の状態 ---
# 起動時の聞き取りフラグ (on/off)
HUB_LISTEN_DEFAULT=on
# 起動時の口パクアニメーション (on/off)
HUB_ANIM_MOUTH_DEFAULT=on

# --- 音声プラグイン ---
# 音声認識: whisper / none / entry point 名 / module.path:factory
STT_PLUGIN=whisper
# 音声合成: voicevox / none / entry point 名 / module.path:factory
TTS_PLUGIN=voicevox

# --- whisper (STT) ---
# faster-whisper のモデル名またはローカルパス (CPU で遅い場合は small など)
STT_MODEL=large-v3-turbo
# auto / cuda / cpu (auto は CUDA デバイスがあれば cuda)
STT_DEVICE=auto
# auto / float16 / int8 など (auto は cuda なら float16、cpu なら int8)
STT_COMPUTE_TYPE=auto
# 認識言語
STT_LANGUAGE=ja

# --- voicevox (TTS) ---
# VOICEVOX ENGINE の URL
VOICEVOX_URL=http://127.0.0.1:50021
# 話者 (スタイル) ID (1 = ずんだもん あまあま。音声を公開する場合はクレジット表記が必要)
VOICEVOX_SPEAKER=1
# 話速 (speedScale)
VOICEVOX_SPEED=1.0
# 合成のタイムアウト [s]
TTS_TIMEOUT_S=120

# --- 音声の共通処理 ---
# 認識結果から捨てる NG ワードのファイル (完全一致)
STT_NG_WORDS_PATH=stt_ng_words.txt
# 端末との音声のサンプルレート [Hz] (端末は 16000 固定)
SAMPLE_RATE=16000
# VAD の発話判定しきい値 (0..1)
VAD_THRESHOLD=0.5
# この長さの無音で発話終了とする [ms]
VAD_MIN_SILENCE_MS=800
# 発話の前に含める音声 [ms]
VAD_SPEECH_PAD_MS=300
# 1 発話の最大長 [s]
VAD_MAX_SPEECH_S=30
# 発話音声の先送り量 [s]
SPEAK_PREBUFFER_S=2.0
# 先送り後に実時間で送る 1 回分 [s]
SPEAK_SLICE_S=0.5

# --- VLM ---
# VLM のバックエンド: ollama / none
VLM_BACKEND=ollama
# Ollama の URL
VLM_URL=http://127.0.0.1:11434
# 画像入力 (vision) に対応したモデル
VLM_MODEL=qwen3.5:9b
# 1 要求の上限 (初回のモデルロード込み) [s]
VLM_TIMEOUT_S=60
# 最後の要求からモデルを VRAM に載せておく時間
VLM_KEEP_ALIVE=10m
# コンテキスト長
VLM_NUM_CTX=8192
# 温度
VLM_TEMPERATURE=0.2
# 回答の最大トークン数
VLM_NUM_PREDICT=400
# 必要な Ollama の最小版
VLM_MIN_VERSION=0.17.1

# --- VLM への質問応答 ---
# 処理待ちの質問の上限 (超えたら busy)
VLM_QA_QUEUE_MAX=3
# 質問の最大文字数 (超えたら invalid)
VLM_QA_MAX_QUESTION_CHARS=500
# この秒数より古いカメラ画像では答えない (no_frame) [s]
VLM_QA_FRAME_MAX_AGE_S=2.0
# 回答に使った画像を何件分保持するか (GET /vlm/frame/{id})
VLM_QA_FRAME_KEEP=20
# システムプロンプト (空なら既定の日本語プロンプト)
VLM_QA_SYSTEM_PROMPT=
# 起動時に「音声で質問」を ON にする (on/off)
VLM_VOICE_INPUT_DEFAULT=off
# 起動時に「音声で回答」を ON にする (on/off)
VLM_VOICE_OUTPUT_DEFAULT=off
