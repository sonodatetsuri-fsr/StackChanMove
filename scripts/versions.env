# セットアップで固定する版・URL・SHA256 (setup_ubuntu.sh / setup_windows.ps1 / openmovehub.doctor が読む)。
# 書式: KEY=VALUE (引用符・空白・変数展開なし)。bash の source と PowerShell・Python の行パースの両方で読む。
# VOICEVOX の SHA256 は GitHub Releases API の asset digest (2026-10-13 取得)。
# 分割アーカイブは _URL_1.._URL_n / _SHA256_1.._SHA256_n と _PARTS で表す。

PYTHON_VERSION=3.12
OLLAMA_MIN_VERSION=0.17.1
VLM_MODEL_DEFAULT=qwen3.5:9b
HUB_PORT_DEFAULT=8341

# 空きディスク [GB] (--skip-vlm 時は MIN_DISK_GB_NO_VLM)
MIN_DISK_GB=25
MIN_DISK_GB_NO_VLM=15

VOICEVOX_VERSION=0.25.2
VOICEVOX_PORT=50021

# Ubuntu: CPU 版 (既定)
VOICEVOX_LINUX_CPU_PARTS=1
VOICEVOX_LINUX_CPU_URL_1=https://github.com/VOICEVOX/voicevox_engine/releases/download/0.25.2/voicevox_engine-linux-cpu-x64-0.25.2.7z.001
VOICEVOX_LINUX_CPU_SHA256_1=bab016a966131b89bad398e7b898f8c742617dc80a7da49bf494cd07133dbc7a

# Ubuntu: GPU 版 (--voicevox-gpu、NVIDIA)
VOICEVOX_LINUX_GPU_PARTS=2
VOICEVOX_LINUX_GPU_URL_1=https://github.com/VOICEVOX/voicevox_engine/releases/download/0.25.2/voicevox_engine-linux-nvidia-0.25.2.7z.001
VOICEVOX_LINUX_GPU_SHA256_1=b7e2fb54ed6abca3f4003982e97e8496a254a8d0b93ade4a9dd6a3fcca946479
VOICEVOX_LINUX_GPU_URL_2=https://github.com/VOICEVOX/voicevox_engine/releases/download/0.25.2/voicevox_engine-linux-nvidia-0.25.2.7z.002
VOICEVOX_LINUX_GPU_SHA256_2=775d0c495535d44cab77ec219b80e2495a7e151f61ffda70489c4d0d96d52d04

# Windows: CPU 版 (既定)
VOICEVOX_WINDOWS_CPU_PARTS=1
VOICEVOX_WINDOWS_CPU_URL_1=https://github.com/VOICEVOX/voicevox_engine/releases/download/0.25.2/voicevox_engine-windows-cpu-0.25.2.7z.001
VOICEVOX_WINDOWS_CPU_SHA256_1=2ab86e4bf29448e3317ee97327efb3211c4ecc1063b03a62ab72b15a92ec531d

# Windows: GPU 版 (--voicevox-gpu、DirectML)
VOICEVOX_WINDOWS_GPU_PARTS=1
VOICEVOX_WINDOWS_GPU_URL_1=https://github.com/VOICEVOX/voicevox_engine/releases/download/0.25.2/voicevox_engine-windows-directml-0.25.2.7z.001
VOICEVOX_WINDOWS_GPU_SHA256_1=8441fda447a15e30dc783813fed2098bc559a358b8de87001083e73460dff5fd

# Windows: VOICEVOX の展開に使う 7-Zip (単体実行ファイル、システムには入れない)
SEVENZR_URL=https://www.7-zip.org/a/7zr.exe
SEVENZR_SHA256=256feca8e274e5da655e2a284fabafd9f554365eb164862089dacd4e8276d282

# PlatformIO の udev ルール (Ubuntu)
PIO_UDEV_RULES_URL=https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/system/99-platformio-udev.rules
